{
  "schema": "worldloom.anvil-mapping/v1",
  "connector": "onedrive",
  "service": "onedrive",
  "contract": "Microsoft Graph v1.0 OpenAPI (msgraph-metadata openapi/v1.0/openapi.yaml), compiled under profiles/onedrive.yaml with --service onedrive",
  "error_body": {"error": {"code": "{errorCode}", "message": "{text}"}},
  "operations": {
    "onedrive.drives.search": {
      "route": "GET /drives/{drive-id}/search(q='{q}')",
      "vendor": "drives.drive.search",
      "tool": "search_items",
      "args": {
        "query": {"from": "path.q", "required": true},
        "drive_id": "path.drive-id",
        "fields": {"from": "query.$select", "transform": "csv"},
        "max_results": {"from": "query.$top", "transform": "int"}
      },
      "cursor": "query.$skiptoken",
      "result": {"shape": "list", "envelope": {"value": "$items"}}
    },
    "onedrive.children.list": {
      "route": "GET /drives/{drive-id}/items/{driveItem-id}/children",
      "vendor": "drives.items.ListChildren",
      "tool": "list_children",
      "args": {
        "id": {"from": "path.driveItem-id", "required": true},
        "fields": {"from": "query.$select", "transform": "csv"},
        "max_results": {"from": "query.$top", "transform": "int"}
      },
      "cursor": "query.$skiptoken",
      "result": {"shape": "list", "envelope": {"value": "$items"}}
    },
    "onedrive.items.get": {
      "route": "GET /drives/{drive-id}/items/{driveItem-id}",
      "vendor": "drives.GetItems",
      "tool": "get_item",
      "args": {
        "id": {"from": "path.driveItem-id", "required": true},
        "fields": {"from": "query.$select", "transform": "csv"}
      },
      "result": "record"
    },
    "onedrive.content.list": {
      "route": "GET /drives/{drive-id}/items/{driveItem-id}/content",
      "vendor": "drives.GetItemsContent",
      "tool": "download_content",
      "args": {"id": {"from": "path.driveItem-id", "required": true}},
      "result": "record"
    },
    "onedrive.children.create": {
      "route": "POST /drives/{drive-id}/items/{driveItem-id}/children",
      "vendor": "drives.items.CreateChildren",
      "tool": "upload_file",
      "tool_by": {"from": "body.folder", "map": {"*": "create_folder"}},
      "args": {
        "entity": {"from": "body", "transform": "drive_item_entity", "required": true},
        "name": {"from": "body.name", "required": true},
        "parent": {"from": "path.driveItem-id", "required": true},
        "fields": {"object": {"name": "body.name", "description": "body.description"}, "transform": "fields"}
      },
      "result": "record"
    },
    "onedrive.items.update": {
      "route": "PATCH /drives/{drive-id}/items/{driveItem-id}",
      "vendor": "drives.UpdateItems",
      "tool": "update_item",
      "tool_by": {"from": "body.parentReference.id", "map": {"*": "move_item"}},
      "args": {
        "id": {"from": "path.driveItem-id", "required": true},
        "parent": "body.parentReference.id",
        "fields": {"object": {"name": "body.name", "description": "body.description"}, "transform": "fields"}
      },
      "result": "record"
    },
    "onedrive.items.delete": {
      "route": "DELETE /drives/{drive-id}/items/{driveItem-id}",
      "vendor": "drives.DeleteItems",
      "tool": "delete_item",
      "args": {"id": {"from": "path.driveItem-id", "required": true}},
      "result": "empty"
    },
    "onedrive.copy.create": {
      "route": "POST /drives/{drive-id}/items/{driveItem-id}/copy",
      "vendor": "drives.drive.items.driveItem.copy",
      "tool": "copy_item",
      "args": {
        "id": {"from": "path.driveItem-id", "required": true},
        "dest": {"from": ["body.parentReference.id", "body.ParentReference.id"]}
      },
      "result": "empty"
    },
    "onedrive.content.replace": {"route": "PUT /drives/{drive-id}/items/{driveItem-id}/content", "vendor": "drives.UpdateItemsContent", "unmodelled": "a file's bytes are rendered from the corpus; uploading new bytes is not modelled"},
    "onedrive.content.delete": {"route": "DELETE /drives/{drive-id}/items/{driveItem-id}/content", "vendor": "drives.DeleteItemsContent", "unmodelled": "a file's bytes are rendered from the corpus; deleting them apart from the file is not modelled"},
    "onedrive.checkin.create": {"route": "POST /drives/{drive-id}/items/{driveItem-id}/checkin", "vendor": "drives.drive.items.driveItem.checkin", "unmodelled": "check-in and check-out are not modelled"},
    "onedrive.checkout.create": {"route": "POST /drives/{drive-id}/items/{driveItem-id}/checkout", "vendor": "drives.drive.items.driveItem.checkout", "unmodelled": "check-in and check-out are not modelled"},
    "onedrive.create_link.create": {"route": "POST /drives/{drive-id}/items/{driveItem-id}/createLink", "vendor": "drives.drive.items.driveItem.createLink", "unmodelled": "sharing is the corpus's access control list, not records the connector writes"},
    "onedrive.invite.create": {"route": "POST /drives/{drive-id}/items/{driveItem-id}/invite", "vendor": "drives.drive.items.driveItem.invite", "unmodelled": "sharing is the corpus's access control list, not records the connector writes"},
    "onedrive.permissions.list": {"route": "GET /drives/{drive-id}/items/{driveItem-id}/permissions", "vendor": "drives.items.ListPermissions", "unmodelled": "sharing is the corpus's access control list, not records the connector writes"},
    "onedrive.permissions.create": {"route": "POST /drives/{drive-id}/items/{driveItem-id}/permissions", "vendor": "drives.items.CreatePermissions", "unmodelled": "sharing is the corpus's access control list, not records the connector writes"},
    "onedrive.items.create": {"route": "POST /drives/{drive-id}/items/{driveItem-id}/restore", "vendor": "drives.drive.items.driveItem.restore", "unmodelled": "the recycle bin is not modelled; a delete removes the item"},
    "onedrive.recent.get": {"route": "GET /drives/{drive-id}/recent()", "vendor": "drives.drive.recent", "unmodelled": "recent-use history is not modelled"},
    "onedrive.shared_with_me.get": {"route": "GET /drives/{drive-id}/sharedWithMe()", "vendor": "drives.drive.sharedWithMe", "unmodelled": "sharing is the corpus's access control list, not records the connector writes"},
    "onedrive.root.list": {"route": "GET /drives/{drive-id}/root", "vendor": "drives.GetRoot", "unmodelled": "the drive root is the corpus's layout, not a record"}
  }
}
