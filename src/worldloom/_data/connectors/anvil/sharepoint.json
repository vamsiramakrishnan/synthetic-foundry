      "vendor": "sites.GetPages",
      "tool": "get_page",
      "args": {"id": {"from": "path.baseSitePage-id", "required": true}},
      "result": "record"
    },
    "sharepoint.pages.create": {
      "route": "POST /sites/{site-id}/pages",
      "vendor": "sites.CreatePages",
      "tool": "create_page",
      "args": {
        "entity": {"value": "site_page"},
        "name": {"from": "body.name", "required": true},
        "parent": "path.site-id",
        "fields": {"object": {"title": "body.title", "name": "body.name", "description": "body.description"},
                   "transform": "fields"}
      },
      "result": "record"
    },
    "sharepoint.pages.update": {
      "route": "PATCH /sites/{site-id}/pages/{baseSitePage-id}",
