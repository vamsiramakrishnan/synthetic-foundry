  "operations": {
    "sharepoint.drives.search": {
      "route": "GET /drives/{drive-id}/search(q='{q}')",
      "vendor": "drives.drive.search",
      "tool": "search_files",
      "args": {
        "query": {"from": "path.q", "required": true},
        "fields": {"from": "query.$select", "transform": "csv"},
        "max_results": {"from": "query.$top", "transform": "int"}
      },
      "cursor": "query.$skiptoken",
      "result": {"shape": "list", "envelope": {"value": "$items"}}
    },
    "sharepoint.items.get.drives": {
      "route": "GET /drives/{drive-id}/items/{driveItem-id}",
      "vendor": "drives.GetItems",
      "tool": "get_file",
      "tool_by": {"from": "record.entity", "map": {"folder": "list_folder"}},
      "args": {
        "id": {"from": "path.driveItem-id", "required": true},
        "fields": {"from": "query.$select", "transform": "csv"}
      },
      "result": "record"
    },
    "sharepoint.children.create": {
      "route": "POST /drives/{drive-id}/items/{driveItem-id}/children",
      "vendor": "drives.items.CreateChildren",
      "tool": "create_file",
      "tool_by": {"from": "body.folder", "map": {"*": "create_folder"}},
      "args": {
        "entity": {"from": "body", "transform": "drive_item_entity", "required": true},
        "name": {"from": "body.name", "required": true},
        "parent": {"from": "path.driveItem-id", "required": true},
        "fields": {"object": {"name": "body.name", "description": "body.description"}, "transform": "fields"}
      },
      "result": "record"
    },
    "sharepoint.items.update.drives": {
      "route": "PATCH /drives/{drive-id}/items/{driveItem-id}",
      "vendor": "drives.UpdateItems",
      "tool": "update_file",
      "tool_by": {"from": "body.parentReference.id", "map": {"*": "move_file"}},
      "args": {
        "id": {"from": "path.driveItem-id", "required": true},
        "parent": "body.parentReference.id",
        "fields": {"object": {"name": "body.name", "description": "body.description"}, "transform": "fields"}
      },
      "result": "record"
    },
    "sharepoint.items.delete.drives": {
      "route": "DELETE /drives/{drive-id}/items/{driveItem-id}",
      "vendor": "drives.DeleteItems",
      "tool": "delete_file",
      "args": {"id": {"from": "path.driveItem-id", "required": true}},
      "result": "empty"
    },
    "sharepoint.items.list": {
      "route": "GET /sites/{site-id}/lists/{list-id}/items",
      "vendor": "sites.lists.ListItems",
      "tool": "get_list_items",
      "args": {
        "entity": {"value": "list_item"},
        "query": {"object": {"$filter": "query.$filter", "$orderby": "query.$orderby"}, "transform": "odata"},
        "max_results": {"from": "query.$top", "transform": "int"}
      },
      "cursor": "query.$skiptoken",
      "result": {"shape": "list", "envelope": {"value": "$items"}}
    },
    "sharepoint.items.create": {
      "route": "POST /sites/{site-id}/lists/{list-id}/items",
      "vendor": "sites.lists.CreateItems",
      "tool": "create_list_item",
      "args": {
        "entity": {"value": "list_item"},
        "name": "body.fields.Title",
        "parent": "path.list-id",
        "fields": {"object": {"fields": "body.fields"}, "required": true}
      },
      "result": "record"
    },
    "sharepoint.items.delete.lists": {
      "route": "DELETE /sites/{site-id}/lists/{list-id}/items/{listItem-id}",
      "vendor": "sites.lists.DeleteItems",
      "tool": "delete_list_item",
      "args": {"id": {"from": "path.listItem-id", "required": true}},
      "result": "empty"
    },
    "sharepoint.pages.list": {
      "route": "GET /sites/{site-id}/pages",
      "vendor": "sites.ListPages",
      "tool": "search_pages",
      "args": {
        "query": "query.$search",
        "max_results": {"from": "query.$top", "transform": "int"}
