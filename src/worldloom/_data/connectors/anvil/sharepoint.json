    "sharepoint.fields.list": {"route": "GET /sites/{site-id}/lists/{list-id}/items/{listItem-id}/fields", "vendor": "sites.lists.items.GetFields", "unmodelled": "the sharepoint definition reads list items by listing them, not one by id"},
    "sharepoint.fields.update": {"route": "PATCH /sites/{site-id}/lists/{list-id}/items/{listItem-id}/fields", "vendor": "sites.lists.items.UpdateFields", "unmodelled": "Graph merges a list item's fields where the emulator replaces them; served, the two would disagree"},
    "sharepoint.fields.delete": {"route": "DELETE /sites/{site-id}/lists/{list-id}/items/{listItem-id}/fields", "vendor": "sites.lists.items.DeleteFields", "unmodelled": "a list item's fields are not deleted apart from the item"},
