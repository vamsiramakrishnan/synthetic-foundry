{
  "schema": "worldloom.rhetoric/v1",
  "about": "Rhetorical moves: what each section of a document has to do, in order, and which facts each step may draw on. A section's moves become its narration request's `moves`; the writer is asked for one paragraph per move, and the offline narrator realises each move from its sentence plans. The instruction a writer reads for a move is the prompts pack text `narrative.move.<name>`, so a pack can change how a move is asked for without code.",
  "moves": {
    "headline": {"about": "The one figure that matters most, and the verdict on it.", "kinds": ["financial.revenue.variance", "financial.gross_profit.variance", "metric.gross_margin_variance", "financial.", "metric.", "close.status", "ops.valuation_status"]},
    "comparison": {"about": "The same figures set against budget, forecast and the prior period.", "kinds": ["financial.", "metric.", "overhead."]},
    "attribution": {"about": "Where the movement happened: which unit or line carried it and which held up.", "kinds": ["financial.revenue.", "financial.gross_profit.variance", "overhead.shared_services.recharge", "financial.", "overhead."], "take": 3},
    "driver": {"about": "What moved the result, cause tied to figure, structural or one-off.", "kinds": ["metric.", "financial.incident_pl_impact"]},
    "cause": {"about": "The established cause, and the line of enquiry that was ruled out.", "kinds": ["ops.cause", "ops.cause_ruled_out", "ops.root_cause_classification", "ops.previous_similar_incident"]},
    "chronology": {"about": "What happened, in the order it happened, including the wrong turn.", "kinds": ["ops.", "close."]},
    "impact": {"about": "The cost in the units the business feels: records, days, the close, money.", "kinds": ["ops.affected_records", "close.delay", "close.revised_date", "financial.incident_pl_impact", "ops.valuation_status"]},
    "status": {"about": "Where things stand now, with the confidence of the moment.", "kinds": ["close.", "ops.feed_status", "ops.valuation_status", "ops.incident_opened", "ops.cause"]},
    "decision": {"about": "What the reader is asked to note or decide.", "kinds": ["ops.remediation", "close.status", "financial."]},
    "action": {"about": "What is being done, by whom, and which action fixes the control rather than the symptom.", "kinds": ["ops.remediation", "ops.workaround", "ops.remediation_addresses", "ops.mapping_table_owner"]},
    "owner": {"about": "Who owns the next step, and where ownership is missing.", "kinds": ["ops.mapping_table_owner"]},
    "risk": {"about": "What is still exposed after the fix, and what would make it recur.", "kinds": ["ops.root_cause_classification", "ops.previous_similar_incident", "ops.mapping_table_owner", "ops.remediation_addresses"]},
    "procedure": {"about": "The steps, in order, in the imperative.", "kinds": ["ops.workaround", "ops.", "close."]},
    "context": {"about": "The situation a reader needs before the detail: the symptom they will recognise.", "kinds": ["ops.feed_status", "ops.incident_opened", "ops.", "close."]},
    "implication": {"about": "What the figures mean for this reader, drawn from the facts already cited.", "kinds": [], "derived": true},
    "transition": {"about": "The line that hands the reader to what comes next.", "kinds": [], "derived": true}
  },
