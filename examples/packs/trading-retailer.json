  "lore": [
    {
      "kind": "norm",
      "assertion": "Trade funding — rebates and promotional contributions — is agreed in annual joint business plans and recognised monthly against the signed agreement, never on handshakes. An unsigned plan books nothing.",
      "constrains": [
        {
          "kind": "terminology",
          "target": "trade_funding",
          "effect": "'Trade funding' covers rebates and promotional contributions together; the two are not interchangeable line items."
        }
      ],
      "effective_from": "2024-07"
    },
    {
      "kind": "norm",
      "assertion": "Every trade agreement passes a legal and controls review before signature. The review can and does hold agreements — a held agreement is a position, not a failure.",
      "constrains": [
        {
          "kind": "terminology",
          "target": "legal_review",
          "effect": "'Cleared' and 'held' are review outcomes; 'approved' belongs to the signature, not the review."
        }
      ],
      "effective_from": "2024-07"
    },
    {
      "kind": "decision",
      "assertion": "The checkout and loyalty replatform runs as a funded programme with monthly steering. Spend is reported cumulatively against a fixed envelope; the programme does not rebase its own budget.",
      "effective_from": "2025-09",
      "constrains": [
        {
          "kind": "artifact_density",
          "target": "filing/project_status_report",
          "effect": "A funded programme that reported nothing monthly would contradict its own governance.",
          "magnitude": 1.0
        }
      ]
    }
  ],
  "voices": {
