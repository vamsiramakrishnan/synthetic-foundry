  "lore": [
    {
      "kind": "norm",
      "assertion": "Every franchisee receives a monthly trading statement, because the franchise agreement computes their fee off the group's reported figures and gives them a right to see them.",
      "effective_from": "2019-04",
      "constrains": [
        {
          "kind": "artifact_density",
          "target": "filing/franchisee_trading_statement",
          "effect": "The network is sent a statement of the month every period",
          "magnitude": 1.0
        },
        {
          "kind": "terminology",
          "target": "trading statement",
          "effect": "A franchisee is sent a statement, never a report — the word is in the agreement"
        }
      ]
    },
    {
      "kind": "tension",
      "assertion": "Wholesale supply to the network carries a thin margin the company's own stores do not, so a month that reads well at group level can read badly to a franchisee.",
      "effective_from": "2022-09",
      "constrains": [
        {
          "kind": "metric_emphasis",
          "target": "forecast_miss/franchise_network",
          "effect": "Supply volumes are forecast optimistically and the network unit misses",
          "magnitude": 1.6
        }
      ]
    },
    {
      "kind": "norm",
      "assertion": "The board is sent a network health review every month.",
      "effective_from": "2021-01",
      "constrains": [
        {
          "kind": "artifact_density",
