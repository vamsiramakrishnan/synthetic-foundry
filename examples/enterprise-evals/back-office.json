{
  "name": "back-office",
  "industry": "shared_services",
  "company_description": "A multi-entity group whose finance, procurement, people and legal teams run month-end close, three-way match exceptions, new-hire onboarding and supplier contract renewals across a system of record, ticketing, document stores and email. Each workflow also posts a notification to Slack or Microsoft Teams beside its record, page, file or email, so a run exercises a chat destination as well as a document one.",
  "workflows": [
    "finance_month_end_close",
    "procurement_exception_review",
    "hr_onboarding_readiness",
    "contract_renewal_review",
    "executive_digest"
  ],
  "connectors": [
    "jira",
    "confluence",
    "sharepoint",
    "drive",
    "servicenow",
    "salesforce",
    "email",
    "sor",
    "slack",
    "teams"
  ],
